# ==========================================
# Stress Companion - Environment Variables
# ==========================================

# 1. Backend API Configuration
# This is the base URL for your FastAPI REST endpoints.
# For local development, leave this as localhost.
# For production, change this to your deployed HTTPS URL (e.g., https://api.yourdomain.com)
VITE_API_BASE_URL=http://localhost:8000

# 2. Backend WebSocket Configuration
# This is the base URL for your FastAPI WebSocket connections (Optical & Thermal feeds).
# For local development, leave this as localhost.
# For production, change this to your deployed WSS URL (e.g., wss://api.yourdomain.com)
VITE_WS_BASE_URL=ws://localhost:8000